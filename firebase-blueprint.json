{
  "entities": {
    "teachers": {
      "title": "Teacher",
      "description": "Teacher and staff profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "subject": { "type": "string" },
        "departmentId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "departments": {
      "title": "Department",
      "description": "School departments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "headId": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "facility_damage_reports": {
      "title": "Facility Damage Report",
      "description": "Phiếu báo hỏng cơ sở vật chất lớp học",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketCode": { "type": "string" },
        "className": { "type": "string" },
        "teacherId": { "type": "string" },
        "facilityGroup": { "type": "string" },
        "assetName": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "ticketCode", "className", "assetName", "status"]
    },
    "classes": {
      "title": "Class Info",
      "description": "Lớp học tại Trường THPT Sơn Lương",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "number" },
        "schoolYear": { "type": "string" }
      },
      "required": ["id", "name", "grade"]
    }
  },
  "firestore": {
    "/facility_damage_reports/{reportId}": {
      "schema": "facility_damage_reports",
      "description": "Classroom facility damage reports"
    }
  }
}
